# Copy to ~/.config/health-log-dashboard/secrets.toml (OUTSIDE this repo) and chmod 600 it.
# Docker Compose bind-mounts that file read-only to /app/.streamlit/secrets.toml.
# For local (non-Docker) runs, either symlink it to .streamlit/secrets.toml (gitignored)
# or copy it to ~/.streamlit/secrets.toml.
#
# Live mode needs sheet_id, worksheet and [gcp_service_account]. If none are present the app
# runs in demo mode; if only some are present it refuses to start (so a typo can't silently
# fall back).

# OPTIONAL. If set, the dashboard asks for this password before showing any data. Delete the
# line to open the dashboard without one (the sidebar then warns that no password is set), which
# is reasonable on a trusted home network. Leaving it blank is an error, not "no password".
app_password = "<choose-a-long-random-password>"

# The id between /d/ and /edit in the Google Sheet URL.
sheet_id = "<google-sheet-id>"

# Tab name inside that spreadsheet, e.g. "Form Responses 1".
worksheet = "<worksheet-name>"

# Fields copied from the service-account JSON key downloaded from Google Cloud.
# Share the sheet with client_email as a *Viewer* only.
[gcp_service_account]
type = "service_account"
project_id = "<project-id>"
private_key_id = "<private-key-id>"
private_key = "<paste the private_key value from the JSON, keeping the \\n escapes>"
client_email = "<name>@<project-id>.iam.gserviceaccount.com"
client_id = "<client-id>"
token_uri = "https://oauth2.googleapis.com/token"
